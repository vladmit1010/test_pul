      { "id": "spf", "label": "Sonnenschutz & Prävention", "block": "A" },
      { "id": "aging-signs", "label": "Hautalterungs-Zeichen", "block": "B" },
      { "id": "price", "label": "Kosten & Preis-Leistung", "block": "B" },
      { "id": "pressure", "label": "Gesellschaftlicher Druck", "block": "B" },
      { "id": "safety", "label": "Sicherheit & Vertrauen", "block": "B" },
      { "id": "natural", "label": "Natürlichkeit & Authentizität", "block": "B" },
      { "id": "celebrity", "label": "Prominente & Influencer-Diskurs", "block": "B" }
    ]
  },
  "chart3_segmentation": {
    "rule": "Exactly one segment when personal positioning is clear; otherwise segment=null (unpositioned). Percents use positioned subset only.",
    "segments": [
      {
        "id": "procedure-open",

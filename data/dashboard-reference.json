{
  "$schema": "revitalift-dashboard-reference/v1",
  "description": "Reference taxonomy and id system for Revitalift dashboard data collection. Agent output: fill counts and write to js/dashboard-data.js. Charts 4–5 labels/synonyms: also in js/dashboard-taxonomy-de.js (keep ids in sync).",
  "output_file": "js/dashboard-data.js",
  "taxonomy_file_charts_4_5": "js/dashboard-taxonomy-de.js",
  "collection_rules": {
    "chart1": {
      "chart_id": 1,
      "name": "Mood Map",
      "source": "PULSAR comments",
      "structure": "fixed",
      "rule": "Every comment gets exactly one mood id.",
      "output_field": "moodMap.moods[].count"
    },
    "chart2": {
      "chart_id": 2,
      "name": "Topic Landscape",
      "source": "PULSAR comments",
      "structure": "semi-fixed",
      "rule": "Count mentions per candidate topic. positive + negative <= count. UI shows top topN by count.",
      "output_field": "topicLandscape.candidates[]",
      "fields_to_fill": [
        "count",
        "positive",
        "negative"
      ],
      "comment_field": "topics[] (array of topic ids)"
    },
    "chart3": {
      "chart_id": 3,
      "name": "Consumer Segmentation",
      "source": "PULSAR comments",
      "structure": "fixed",
      "rule": "Every comment gets exactly one segment id.",
      "output_field": "segmentation.segments[].count"
    },
    "chart4": {
      "chart_id": 4,
      "name": "Procedures, Effects & Scares",
      "source": "PULSAR comments",
      "audience_segments": [
        "procedure-open",
        "procedure-curious"
      ],
      "structure": "taxonomy fixed, aggregates dynamic",
      "level1_field": "procedure (id from chart4.level1)",
      "level2_field": "procedureTone (id from chart4.level2a or level2b)",
      "output_field": "procedureEffects.aggregates.procedures[]",
      "output_shape": {
        "id": "procedure id from level1",
        "tones": [
          {
            "tone": "level2 id",
            "count": "number"
          }
        ]
      }
    },
    "chart5": {
      "chart_id": 5,
      "name": "Ingredients, Concerns & Results",
      "source": "PULSAR comments",
      "audience_segments": [
        "skincare-first"
      ],
      "structure": "taxonomy fixed, aggregates dynamic",
      "level1_field": "ingredient (id from chart5.level1)",
      "level2_field": "ingredientTone (id from chart5.level2a concern or level2b result)",
      "output_field": "skincareIngredients.aggregates.procedures[]",
      "output_shape": {
        "id": "ingredient id from level1",
        "tones": [
          {
            "tone": "level2 id",
            "count": "number"
          }
        ]
      }
    },
    "chart6": {
      "chart_id": 6,
      "name": "Decision Drivers",
      "source": "Appinio survey n=450",
      "structure": "fixed",
      "rule": "Do NOT recompute from comments. Use fixed survey percent values.",
      "output_field": "decisionDrivers.drivers[].percent"
    }
  },
  "comment_schema": {
    "required": [
      "id",
      "text",
      "mood",
      "segment",
      "topics"
    ],
    "optional": [
      "procedure",
      "procedureTone",
      "ingredient",
      "ingredientTone",
      "tags"
    ],
    "fields": {
      "id": "unique number or string",
      "text": "verbatim quote",
      "mood": "one of chart1.moods[].id",
      "segment": "one of chart3.segments[].id",
      "topics": "array of chart2.candidates[].id",
      "procedure": "chart4 level1 item id (if procedure-related)",
      "procedureTone": "chart4 level2a/2b item id",
      "ingredient": "chart5 level1 item id (if skincare-related)",
      "ingredientTone": "chart5 level2a/2b item id"
    }
  },
  "chart1_moodMap": {
    "schema_note": "LOP REV Dashboard_Prompts — 6 moods. Cautioning wins over positive if concrete warning to others. Conflicted = unresolved ambivalence.",
    "sentiment_buckets": {
      "positive": ["enthusiastic", "satisfied"],
      "neutral": ["seeking", "conflicted"],
      "negative": ["disappointed", "cautioning"]
    },
    "moods": [
      {
        "id": "enthusiastic",
        "label": "Enthusiastic",
        "color": "#f0a86e"
      },
      {
        "id": "satisfied",
        "label": "Satisfied",
        "color": "#e8c98a"
      },
      {
        "id": "seeking",
        "label": "Seeking",
        "color": "#b8c4d4"
      },
      {
        "id": "conflicted",
        "label": "Conflicted",
        "color": "#c4a882"
      },
      {
        "id": "disappointed",
        "label": "Disappointed",
        "color": "#c9a0b8"
      },
      {
        "id": "cautioning",
        "label": "Cautioning",
        "color": "#7eb8d4"
      }
    ]
  },
  "chart2_topicLandscape": {
    "topN": 20,
    "blocks": {
      "A": "Verfahren & Wirkstoffe",
      "B": "Kontext & Haltung"
    },
    "sentiment_from_mood": {
      "positive": ["enthusiastic", "satisfied"],
      "neutral": ["seeking", "conflicted"],
      "negative": ["disappointed", "cautioning"]
    },
